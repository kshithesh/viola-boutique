# Turso Database Configuration
# Obtain your Database URL and Auth Token from the Turso CLI or Dashboard:
# 1. Database URL format: https://your-db-name-your-org.turso.io
# 2. Generate Auth Token: turso db tokens create <your-db-name>

VITE_TURSO_DATABASE_URL=https://your-db-name-your-org.turso.io
VITE_TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Google OAuth — Customer Sign-in
# Create a project at https://console.cloud.google.com > APIs > Credentials > OAuth 2.0 Client ID
# Set Authorized JavaScript origins to: http://localhost:5173 (dev) and your production domain
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# WATI WhatsApp Business API — OTP delivery
# Sign up at https://app.wati.io, connect a WhatsApp Business number,
# and create an approved Authentication template (e.g. named "viola_otp")
# with a {{1}} variable for the OTP code.
# Get your API endpoint and key from WATI Dashboard > API > Credentials.
VITE_WATI_API_ENDPOINT=https://live-server-XXXXX.wati.io
VITE_WATI_API_KEY=your_wati_api_key_here
VITE_WATI_TEMPLATE_NAME=viola_otp
