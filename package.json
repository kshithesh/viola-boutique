{
  "name": "viora-ecommerce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,css,html}\"",
    "type-check": "vue-tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run type-check"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@lucide/vue": "^1.30.0",
    "@vue/devtools-api": "^8.2.1",
    "pinia": "^4.0.2",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.2"
  }
}
